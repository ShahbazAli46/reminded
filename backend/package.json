{
  "name": "reminder-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Reminder++ application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "db:init": "bun src/database/init.ts",
    "build": "bun build src/server.ts --outdir dist --target node"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "fzstd": "^0.1.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.7",
    "semver": "^7.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/semver": "^7.5.8",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
